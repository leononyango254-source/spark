{
  "name": "spark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm build:js && pnpm build:mini",
    "build:js": "node esbuild.config.mjs",
    "build:mini": "pnpm --filter @spark/telegram-mini-app build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @spark/db db:generate",
    "db:migrate": "pnpm --filter @spark/db db:migrate",
    "dev:api": "pnpm --filter @spark/api dev",
    "dev:bot": "pnpm --filter @spark/bot dev",
    "dev:mini": "pnpm --filter @spark/telegram-mini-app dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "drizzle-orm": "0.44.7"
  }
}
