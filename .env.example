# Copy to .env and fill in. Never commit a real .env (see .gitignore).

NODE_ENV=development

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://spark:spark@localhost:5432/spark

# Arc
ARC_NETWORK=testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# CampaignEscrow deployment params (micro-USDC, from PRD examples: $10 cap / $1000 global)
MAX_PAYOUT_MICRO_USDC=10000000
GLOBAL_PAYOUT_ALLOWANCE=1000000000

# Operator wallet (viem EOA). NEVER commit a real value.
OPERATOR_PRIVATE_KEY=

# Deployed CampaignEscrow (Phase 4, Arc testnet)
ESCROW_ADDRESS=0x9539efAFf246799827E6F5E6Cbc475122710Ef64

# Worker settlement/reconciliation
SETTLE_BATCH_LIMIT=25
SETTLE_INTERVAL_SECONDS=15
RECONCILE_INTERVAL_SECONDS=30
SETTLE_MAX_ATTEMPTS=5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=https://localhost:5173
TELEGRAM_APP_NAME=spark

# WalletConnect
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
WALLETCONNECT_RELAY_URL= # optional

# Membership verification cache (ms, default 300000)
MEMBERSHIP_CACHE_TTL_MS=300000

# API
API_PORT=3000

# Auth sessions (seconds, default 30 days)
SESSION_TTL_SECONDS=2592000
